# Copy this file to .env (in the repo root or db/) and fill in your own value.
# Supabase: Project Settings > Database > Connection string > URI
# (use the "Session pooler" connection string, not the direct one, for
# scripts that connect/disconnect quickly like this scraper job)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
